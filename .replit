modules = ["nodejs-18", "web"]
[agent]
expertMode = true
integrations = ["javascript_supabase:1.0.0"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend Server"

[[workflows.workflow]]
name = "Frontend Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- -p 5000 -H 0.0.0.0"
waitForPort = 5000

[[workflows.workflow]]
name = "Dev Server"
author = 48434080
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm install"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run dev -- --port=5000 --hostname=0.0.0.0"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33251
externalPort = 4200

[[ports]]
localPort = 34733
externalPort = 5000

[[ports]]
localPort = 39029
externalPort = 3002

[[ports]]
localPort = 41841
externalPort = 3001

[[ports]]
localPort = 44659
externalPort = 3003

[[ports]]
localPort = 46587
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "pnpm start"]
build = ["sh", "-c", "pnpm install && pnpm run build"]
